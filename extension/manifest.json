{
  "manifest_version": 3,
  "name": "Interndex Capture",
  "version": "0.1.0",
  "description": "Save the job posting you are viewing into your own Interndex account.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "identity"],
  "host_permissions": [
    "https://jobtrack.example.com/*",
    "https://your-project-ref.supabase.co/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save this job to Interndex",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
