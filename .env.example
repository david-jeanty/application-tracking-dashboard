# Public. Find both values in Supabase Dashboard > Project Settings > API or
# the project's Connect dialog. These values are designed to be used by browser
# code; database access is still protected by authentication and row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public. The canonical application origin used to build password-recovery links.
# Use http://localhost:3000 locally and the HTTPS Vercel origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. A Logo.dev PUBLISHABLE key (starts with `pk_`), which shows company
# logos beside employer names. Get one at https://www.logo.dev. Company logos
# are an enhancement: with this unset, Interndex works exactly as before and
# renders a local lettermark instead. Never add a Logo.dev secret or Brand API
# key here — this value is served to the browser.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Optional E2E-only test account. Never use a production account. These variables
# are read by Playwright in Node and must not use the NEXT_PUBLIC_ prefix.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
