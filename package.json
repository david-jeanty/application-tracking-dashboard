{
  "name": "application-tracking-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "extension:typecheck": "tsc --noEmit -p extension/tsconfig.test.json",
    "extension:test": "vitest run --config extension/vitest.config.ts",
    "extension:build": "tsc -p extension/tsconfig.json",
    "extension:check": "npm run extension:typecheck && npm run extension:test && npm run extension:build",
    "extension:package": "npm run extension:build && node extension/scripts/package.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run extension:check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "1.26.0",
    "mcp-handler": "2.1.1",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
